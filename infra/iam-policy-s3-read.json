{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketDoSite",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::SUBSTITUA-PELO-NOME-DO-BUCKET"
    },
    {
      "Sid": "LerArquivosDoSite",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::SUBSTITUA-PELO-NOME-DO-BUCKET/*"
    }
  ]
}
